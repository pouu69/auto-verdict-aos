{
  "name": "autoverdict-webview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:contract": "GEN_CONTRACT=1 vitest run tests/contract",
    "copy-to-assets": "rm -rf ../app/src/main/assets/eval-ui && mkdir -p ../app/src/main/assets && cp -R dist ../app/src/main/assets/eval-ui"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
